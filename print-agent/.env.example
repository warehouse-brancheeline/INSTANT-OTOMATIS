# Leave SERVER_URL empty (default) - the agent auto-detects the dashboard's
# current address every cycle from the same GitHub Pages file the permanent
# dashboard link redirects through, so it keeps working even after the
# Cloudflare quick tunnel URL rotates. Only set this if you want to pin the
# agent to one fixed address instead (e.g. once there's a stable domain).
SERVER_URL=

# Token shown ONCE when this printer was added from the dashboard's
# "Printer Cabang" panel. Copy it exactly.
AGENT_TOKEN=

# How often (seconds) this laptop checks the server for new print jobs.
POLL_INTERVAL_SECONDS=8
